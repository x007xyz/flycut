[
  {
    "name": "get_timeline",
    "description": "Read the open FlyCut project: canvas size, duration, playhead and every clip. Times are in seconds; x/y are offsets in canvas pixels from the canvas centre; scale is a percentage.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "list_assets",
    "description": "List the media assets (video, image, audio) in the resource library. Use an asset id with add_clip.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "import_asset",
    "description": "Import a video (MP4), image or audio file into the resource library from a URL the browser can fetch, or from base64 data. Returns the asset record.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "http(s), blob: or data: URL"
        },
        "data": {
          "type": "string",
          "description": "Base64 file content, used when url is not given"
        },
        "name": {
          "type": "string",
          "description": "File name including extension"
        },
        "mimeType": {
          "type": "string",
          "description": "For example video/mp4, image/png or audio/wav"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "add_clip",
    "description": "Place a library asset on the timeline. Returns the new clip.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string"
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "description": "Start time in seconds, defaults to the playhead"
        }
      },
      "required": [
        "assetId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_text",
    "description": "Add a text (caption) clip. Returns the new clip.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds, defaults to the playhead"
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Seconds, defaults to 60"
        },
        "fontSize": {
          "type": "number",
          "minimum": 1
        },
        "fill": {
          "type": "string",
          "description": "CSS colour"
        },
        "stroke": {
          "type": "string",
          "description": "CSS colour of the outline"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "content"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "update_clip",
    "description": "Change a clip. start moves the clip; duration applies to text and image clips; muted applies to video and audio; content, fontSize, fill and stroke apply to text.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "clipId": {
          "type": "string"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "muted": {
          "type": "boolean"
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "fontSize": {
          "type": "number",
          "minimum": 1
        },
        "fill": {
          "type": "string"
        },
        "stroke": {
          "type": "string"
        }
      },
      "required": [
        "clipId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_animation",
    "description": "Set the entrance (in), exit (out) or loop animation of a video, image or text clip. preset none removes it. in/out presets: fade, left/right/top/bottom (slide from or to that side), zoom-in, zoom-out, pop, blur, rotate, typewriter (text only). loop presets: pulse, float, shake, flicker, spin. duration is in seconds (the loop period for loop); ease is an anime.js easing name, empty for the preset default.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "clipId": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "in",
            "out",
            "loop"
          ]
        },
        "preset": {
          "type": "string",
          "enum": [
            "none",
            "fade",
            "left",
            "right",
            "top",
            "bottom",
            "zoom-in",
            "zoom-out",
            "pop",
            "blur",
            "rotate",
            "typewriter",
            "pulse",
            "float",
            "shake",
            "flicker",
            "spin"
          ]
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "ease": {
          "type": "string",
          "enum": [
            "",
            "linear",
            "outQuad",
            "inQuad",
            "inOutQuad",
            "outBack",
            "outElastic",
            "outBounce"
          ]
        }
      },
      "required": [
        "clipId",
        "kind",
        "preset"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "trim_clip",
    "description": "Trim a video or audio clip: trimStart/trimEnd are the seconds of source media cut from its beginning/end. The clip start stays where it is.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "clipId": {
          "type": "string"
        },
        "trimStart": {
          "type": "number",
          "minimum": 0
        },
        "trimEnd": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "clipId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "split_clip",
    "description": "Split a video clip at a timeline time in seconds. Returns both resulting clips.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "clipId": {
          "type": "string"
        },
        "time": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "clipId",
        "time"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "delete_clips",
    "description": "Delete clips from the timeline.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "clipIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": [
        "clipIds"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_playhead",
    "description": "Move the playhead to a time in seconds.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "time": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "time"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "undo",
    "description": "Undo the last timeline edit.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "redo",
    "description": "Redo the last undone timeline edit.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "generate_subtitles",
    "description": "Recognise speech in the timeline audio with Whisper running in the browser (transformers.js) and add one text clip per sentence. The first run downloads the model. Returns the added clips.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "description": "ISO 639-1 code of the spoken language such as zh or en; defaults to the browser language. Set it explicitly, the model does not detect the language"
        },
        "model": {
          "type": "string",
          "description": "Hugging Face model id, defaults to onnx-community/whisper-tiny; onnx-community/whisper-base and onnx-community/whisper-small are more accurate"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "import_srt",
    "description": "Add subtitles from SRT text as text clips. Returns the added clips.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "content"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "export_srt",
    "description": "Return every text clip on the timeline as SRT text.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "export_video",
    "description": "Render the timeline to a 1080x1920 MP4 (H.264 + Opus) and download it in the browser. Can take minutes for long projects.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "fileName": {
          "type": "string",
          "description": "Defaults to <project name>.mp4"
        }
      },
      "additionalProperties": false
    }
  }
]
